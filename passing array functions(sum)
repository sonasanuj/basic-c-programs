#include<stdio.h>

int sum(int a[], int n);

int main()
{
    int arr[5] = {1,2,3,4,5};
    int ans, n = 5;

    ans = sum(arr, n);

    printf("%d", ans);

    return 0;
}

int sum(int a[], int limit)
{
    int c = 0;

    for(int i = 0; i < limit; i++)
    {
        c = c + a[i];
    }

    return c;
}
