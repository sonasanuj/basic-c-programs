#include<stdio.h>

int power(int x,int n)
{
    if(n == 0)
        return 1;
    else
        return x * power(x, n - 1);
}

int main()
{
    int x, n, pow;

    printf("Enter a number: ");
    scanf("%d",&x);

    printf("Enter the power: ");
    scanf("%d",&n);

    pow = power(x,n);

    printf("Result = %d",pow);

    return 0;
}
