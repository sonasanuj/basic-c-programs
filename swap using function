#include <stdio.h>

void swap(int a,int b); 

int main()
{
  int a,b;
  scanf("%d%d",&a,&b);

  printf("a is : %d b is : %d\n",a,b);

  swap(a,b);

  printf("a is : %d b is : %d\n",a,b);

  return 0;
}

void swap(int a,int b)
{
  int c;
  c = a;
  a = b;
  b = c;

  printf("a is : %d b is : %d\n",a,b);
}
